<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/block_background"
    android:clipChildren="false">

    <com.jamydevph.focapflutter.BlockRingsView
        android:id="@+id/block_rings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/block_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/block_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/block_tile_area"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/block_app_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_block_tile"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />

                    <View
                        android:layout_width="150dp"
                        android:layout_height="44dp"
                        android:layout_gravity="top|center_horizontal"
                        android:background="@drawable/bg_block_cap"
                        android:elevation="8dp"
                        android:rotation="-10"
                        android:translationY="-22dp" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_block_badge"
                        android:importantForAccessibility="no"
                        android:scaleType="center"
                        android:src="@drawable/ic_block_lock"
                        android:translationX="10dp"
                        android:translationY="10dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/block_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:maxLines="3"
                    android:textColor="@color/block_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/block_subtitle"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/block_subtitle"
                    android:textColor="@color/block_text_soft"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/block_time_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_block_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/block_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.034"
                        android:textColor="@color/block_text"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/block_time_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no"
                        android:text="@string/block_time_left"
                        android:textColor="@color/block_text_soft"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/block_go_home"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_block_go_home"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_block_home" />

            <TextView
                android:id="@+id/block_go_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/block_go_home"
                android:textColor="@color/block_button_text"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/block_footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/block_footnote"
            android:textColor="@color/block_text_soft"
            android:textSize="12sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
